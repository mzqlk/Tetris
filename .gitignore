# Dependencies
node_modules/

# Build output
dist/

# Vite cache
*.local

# Environment variables
.env
.env.*
!.env.example

# Editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# ESLint
.eslintcache
.gstack/

# AI training artifacts. The model itself is committed at
# src/ai/trained-weights.json; everything under public/ai is a run artifact.
# The whole directory, not the three filenames it happened to hold first, so
# any future artifact is covered without editing this file again.
public/ai/

# Retired training runs, kept for forensics. NOT under public/ — Vite copies
# that directory verbatim into dist, and a dead run has no business shipping.
training-archive/

# D2 diagnostic evidence. Run-scoped receipts, manifests and run records; the
# whole directory, because the run id is derived per protocol/input identity.
# NOT under public/ — Vite copies that directory verbatim into dist.
diagnostics/
